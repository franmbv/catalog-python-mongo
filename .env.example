# Configuración de MongoDB
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=atrium_db_ej

# Configuración de Red / CORS (separados por comas)
